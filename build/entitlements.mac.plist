<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8's JIT is all Electron needs under the hardened runtime. Nothing else is
       loosened, so no unsigned code or other people's libraries can load into an app
       that has Screen Recording permission. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
